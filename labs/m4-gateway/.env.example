# Copy to .env (never commit real secrets to Git) and create the Kubernetes Secret:
#   kubectl create secret generic litellm-secrets \
#     -n ai-platform \
#     --from-env-file=labs/m4-gateway/.env \
#     --dry-run=client -o yaml | kubectl apply -f -

VLLM_API_KEY=EMPTY
LITELLM_MASTER_KEY=sk-replace-with-32-char-random-master-key
LITELLM_SALT_KEY=sk-replace-with-32-char-random-salt-key
POSTGRES_USER=litellm
POSTGRES_PASSWORD=replace-with-strong-postgres-password
DATABASE_URL=postgresql://litellm:replace-with-strong-postgres-password@postgres-svc.ai-platform.svc.cluster.local:5432/litellm
