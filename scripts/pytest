#!/usr/bin/env python3
"""
Portable Pytest-Compatible Test Runner (`scripts/pytest`)
=========================================================
If upstream `pytest` package is installed in the active Python environment,
delegates directly to `pytest.main()`. Otherwise, executes all `test_*`
functions in discovered `test_*.py` files using Python's standard library
and prints standard pytest-style output.
"""

from __future__ import annotations

import glob
import importlib.util
import inspect
import os
import sys
import time
import traceback

# Check if real upstream pytest library is installed in site-packages
try:
    import _pytest.config  # type: ignore
    import pytest as _real_pytest  # type: ignore

    sys.exit(_real_pytest.main())
except ImportError:
    if os.getenv("REQUIRE_REAL_PYTEST", "0") == "1":
        sys.stderr.write(
            "[FAIL] Upstream pytest is required (REQUIRE_REAL_PYTEST=1) but not installed.\n"
        )
        sys.exit(1)
    sys.stderr.write(
        "[WARN] Upstream pytest not installed; using portable stdlib fallback (scripts/pytest).\n"
    )


def discover_test_files(args: list[str]) -> list[str]:
    targets = [a for a in args if not a.startswith("-")]
    if not targets:
        targets = ["."]
    files: list[str] = []
    for target in targets:
        if os.path.isfile(target):
            files.append(target)
        elif os.path.isdir(target):
            for root, _, filenames in os.walk(target):
                for name in sorted(filenames):
                    if name.startswith("test_") and name.endswith(".py"):
                        files.append(os.path.join(root, name))
        else:
            files.extend(sorted(glob.glob(target)))
    return files


def main() -> int:
    start_ts = time.perf_counter()
    if os.getcwd() not in sys.path:
        sys.path.insert(0, os.getcwd())

    test_files = discover_test_files(sys.argv[1:])
    collected: list[tuple[str, str, object]] = []

    for filepath in test_files:
        rel_path = os.path.relpath(filepath)
        mod_name = os.path.splitext(os.path.basename(filepath))[0]
        spec = importlib.util.spec_from_file_location(mod_name, filepath)
        if spec is None or spec.loader is None:
            continue
        module = importlib.util.module_from_spec(spec)
        sys.modules[mod_name] = module
        spec.loader.exec_module(module)
        for name, obj in inspect.getmembers(module, inspect.isfunction):
            if name.startswith("test_"):
                collected.append((rel_path, name, obj))

    print("============================= test session starts ==============================")
    print(f"platform {sys.platform} -- Python {sys.version.split()[0]}")
    print(f"rootdir: {os.getcwd()}")
    print(f"collected {len(collected)} items\n")

    passed = 0
    failed = 0
    total = len(collected)

    for idx, (rel_path, func_name, func) in enumerate(collected, start=1):
        pct = int((idx / max(1, total)) * 100)
        try:
            func()  # type: ignore[operator]
            passed += 1
            print(f"{rel_path}::{func_name} PASSED [{pct:3d}%]")
        except Exception:
            failed += 1
            print(f"{rel_path}::{func_name} FAILED [{pct:3d}%]")
            traceback.print_exc()

    elapsed = time.perf_counter() - start_ts
    print("")
    if failed == 0:
        print(f"============================== {passed} passed in {elapsed:.2f}s ===============================")
        return 0
    else:
        print(f"=================== {failed} failed, {passed} passed in {elapsed:.2f}s ===================")
        return 1


if __name__ == "__main__":
    sys.exit(main())
